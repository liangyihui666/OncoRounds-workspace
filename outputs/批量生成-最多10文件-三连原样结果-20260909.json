          ],
          "value": "function main({results,expected_count}) {\n  if (!Number.isInteger(expected_count) || expected_count < 1 || expected_count > 10) throw new Error('批量文件数量无效');\n  if (!Array.isArray(results) || results.length > expected_count) throw new Error('批量累计结果无效');\n  const output_data = results.slice();\n  // A container failure may stop subsequent files. Never shift earlier results or invent questions.\n  while (output_data.length < expected_count) {\n    output_data.push({error:{file_index:output_data.length+1,code:'BATCH_INTERRUPTED',message:'批量运行中断，此文件尚未取得有效结果，请查看循环运行详情后重试。'}});\n  }\n  return {output_data,output_json:JSON.stringify(output_data,null,2)};\n}",
