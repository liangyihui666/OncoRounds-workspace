            "custom"
          ],
          "value": "function main({files}) {\n  if (!Array.isArray(files) || files.length < 1 || files.length > 10) {\n    throw new Error('请在病例文件上传框选择 1–10 个文件；超过 10 个请分批提交。');\n  }\n  if (files.some(f => typeof f !== 'string' || !f.trim())) {\n    throw new Error('文件列表包含无效项，请重新选择文件。');\n  }\n  // A single reference to this array preserves its nested per-file arrays.\n  return {file_batches:files.map(f=>[f]), expected_count:files.length, batch_results:[]};\n}",
