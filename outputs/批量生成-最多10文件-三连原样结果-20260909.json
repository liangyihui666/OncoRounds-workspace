        {
          "key": "code",
          "label": "",
          "valueType": "string",
          "renderTypeList": [
            "custom"
          ],
          "value": "function record(previous,index,value) {\n  if (!Array.isArray(previous) || !Number.isInteger(index) || index < 0 || index > 9 || previous.length !== index) {\n    throw new Error('批量结果累计顺序异常，停止以避免错配病例。');\n  }\n  return {batch_results:previous.concat([value])};\n}\nfunction failure(index,code,message) { return {error:{file_index:index+1,code,message}}; }\nfunction isObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v); }\nfunction main({previous,index,answer_text}) {\n  let result;\n  try {\n    if (typeof answer_text !== 'string' || !answer_text.trim()) throw new Error('EMPTY_RESULT');\n    result = JSON.parse(answer_text.replace(/^\\uFEFF/, '').trim());\n  } catch (e) {\n    return record(previous,index,failure(index,'INVALID_JSON','三连未返回可解析的单一 JSON 对象，请查看该轮三连运行详情。'));\n  }\n  // Validate only the public container, never rewrite medical content or audit status.\n  if (!isObject(result) || Object.keys(result).length !== 2 || !isObject(result.Questions) || !isObject(result.detail)\n      || !Array.isArray(result.Questions.questions)\n      || result.Questions.question_count !== result.Questions.questions.length) {\n    return record(previous,index,failure(index,'INVALID_RESULT','三连结果不符合当前 Questions/detail 契约，请检查三连实际运行版本。'));\n  }\n  return record(previous,index,result);\n}",
          "debugLabel": "",
          "toolDescription": ""
        },
