        {
          "key": "code",
          "label": "",
          "valueType": "string",
          "selectedType": "custom",
          "renderTypeList": [
            "custom"
          ],
          "value": "function safeDiagnostic(value){\n  let s=typeof value==='string'?value:value==null?'':JSON.stringify(value);\n  s=s.replace(/\\bBearer\\s+[^\\s\"',;}]+/gi,'Bearer [REDACTED]').replace(/\\bsk-[A-Za-z0-9_-]+/g,'[REDACTED]');\n  s=s.replace(/((?:api[_-]?key|access[_-]?token|authorization|password|secret|signature|credential)\\s*[\"']?\\s*[:=]\\s*[\"']?)[^\\s\"'&,;}]+/gi,'$1[REDACTED]');\n  return s.length>2000?s.slice(0,2000)+'…[truncated]':s;\n}\nfunction teachingErrors(q) {\n const errors=[];\n const rows=typeof q.explain==='string'?q.explain.trim().split(/\\r?\\n/).filter(s=>s.trim()):[];\n const answer=typeof q.answer==='number'?q.answer:['A','B','C','D'].indexOf(q.answer);\n if(rows.length!==4) errors.push('解析必须恰好四行，按A/B/C/D逐项解释');\n for(let i=0;i<4;i++){\n   const letter='ABCD'[i], row=rows[i]||'';\n   const match=row.match(/^([A-D])｜(正确|不正确)：(.+)$/);\n   if(!match||match[1]!==letter||match[2]!== (i===answer?'正确':'不正确')||!match[3].trim()) errors.push(letter+'解析缺失、格式错误或与答案不一致');\n }\n if(typeof q.explain==='string'&&q.explain.length>800)errors.push('逐项解析超过800字');\n if(/^【延伸情境】/.test(q.question||'')&&!/假设|若后续/.test(q.question))errors.push('延伸题须明确标注假设条件');\n return errors;\n}\n\nfunction main({results,expected_count}) {\n  if (!Number.isInteger(expected_count) || expected_count < 1 || expected_count > 10) throw new Error('批量文件数量无效');\n  const object=v=>v!==null && typeof v==='object' && !Array.isArray(v);\n  const nonempty=v=>typeof v==='string'&&v.trim().length>0;\n  const items=[];\n  const fail=(index,code,message,diagnostics)=>{\n    items.push({file_index:index+1,status:'failed',code,message,...diagnostics?{diagnostics}: {}});\n    return {error:{file_index:index+1,code,message}};\n  };\n  // Never compact successful rows: failure positions must match uploaded files.\n  if (results!=null && !Array.isArray(results)) throw new Error('并行完整结果不是数组');\n  const rows=results || [];\n  if(rows.length && rows.length!==expected_count) throw new Error('并行结果数量不一致，停止以避免病例错位');\n  const output_data=Array.from({length:expected_count},(_,index)=>{\n    const row=rows[index];\n    if(!row) return fail(index,'BATCH_INTERRUPTED','并行运行未取得此文件的结果，请查看运行详情后单独重试。');\n    const diagnostics={scope:'debug_only',success:row.success,data_type:row.data===null?'null':typeof row.data,data_chars:typeof row.data==='string'?row.data.length:null,upstream_message:safeDiagnostic(row.message)};\n    if(row.success!==true) return fail(index,'CHILD_WORKFLOW_ERROR','此文件执行失败，原始错误见batch_report诊断。',diagnostics);\n    if(row.data==null||typeof row.data==='string'&&!row.data.trim())return fail(index,'EMPTY_CHILD_RESPONSE','单例应用返回为空，不是JSON格式损坏。',diagnostics);\n    let result;\n    try {\n      if(object(row.data)) result=row.data;\n      else { if(typeof row.data!=='string' || !row.data.trim()) throw new Error('EMPTY_RESULT'); result=JSON.parse(row.data.replace(/^\\uFEFF/,'').trim()); }\n    } catch(e) { return fail(index,'INVALID_CHILD_JSON','单例返回非空但无法解析，详见诊断。',{...diagnostics,parse_error:safeDiagnostic(e.message),response_preview:safeDiagnostic(row.data)}); }\n    if(object(result)&&result.record_type==='oncorounds_execution_error'){\n      if(result.transport_version!=='1.0'||!object(result.error))return fail(index,'INVALID_ERROR_TRANSPORT','错误返回格式不完整。',diagnostics);\n      return fail(index,String(result.error.code||'UPSTREAM_NODE_ERROR'),'单例执行未完成，具体节点及错误见batch_report。',{...diagnostics,error:{code:safeDiagnostic(result.error.code),node:safeDiagnostic(result.error.node),message:safeDiagnostic(result.error.message)}});\n    }\n    let execution_report=null;\n    if(object(result)&&result.record_type==='oncorounds_batch_item'){\n      if(result.transport_version!=='1.0'||!object(result.execution_report))return fail(index,'INVALID_TRANSPORT','批量传输版本或执行报告缺失。');\n      execution_report=result.execution_report;result=result.output_data;\n    }\n    if(!object(result)||Object.keys(result).length!==2||!object(result.Questions)||!object(result.detail)\n      ||!Array.isArray(result.Questions.questions)||!Number.isInteger(result.Questions.question_count)\n      ||result.Questions.question_count!==result.Questions.questions.length) {\n      return fail(index,'INVALID_RESULT','三连结果不符合 Questions/detail 契约，请检查被调用应用。');\n    }\n    const q=result.Questions, d=result.detail;\n    if(execution_report&&execution_report.case_id!==q.case_id)return fail(index,'EXECUTION_CASE_MISMATCH','执行报告与题目的病例标识不同。');\n    // Public display contract only requires cancer_type. Internal/legacy second_cancer_type is optional.\n    if(typeof q.cancer_type!=='string'||(Object.keys(d).length&&d.cancer_type!==q.cancer_type)\n      ||(q.second_cancer_type!==undefined&&typeof q.second_cancer_type!=='string')\n      ||(d.second_cancer_type!==undefined&&typeof d.second_cancer_type!=='string')\n      ||(q.second_cancer_type!==undefined&&d.second_cancer_type!==undefined&&q.second_cancer_type!==d.second_cancer_type))\n      return fail(index,'INVALID_TAXONOMY','题目与病例页癌种不一致或字段类型错误。');\n    if(Object.keys(d).length&&(!nonempty(q.case_id)||q.case_id!==d.case_id))\n      return fail(index,'CASE_ID_MISMATCH','题目与病例页的病例标识不一致。');\n    if(q.question_count===0&&q.generation_status==='insufficient'){\n      const status=execution_report?.status;\n      const broken=['FORMAT_ERROR','UPSTREAM_ERROR'].includes(status);\n      if(status==='OUTPUT_READY')return fail(index,'STATUS_CONFLICT','执行报告声称完成但题目为空。');\n      items.push({file_index:index+1,status:broken?'failed':'incomplete',code:status||'NO_COMPLETE_QUESTION_SET',question_count:0,execution_report,\n        missing_information:Array.isArray(q.missing_information)?q.missing_information:[]});\n      return result; // Keep the case page and upstream insufficiency information.\n    }\n    if(execution_report&&execution_report.status!=='OUTPUT_READY')return fail(index,'STATUS_CONFLICT','五题结果与上游执行状态不一致。');\n    if(q.question_count!==5||q.generation_status!=='success')\n      return fail(index,'INCOMPLETE_QUESTION_SET','每个成功病例必须完整输出5题；当前返回'+q.question_count+'题，未计入完成。');\n    if(!nonempty(q.case_id)||!nonempty(q.cancer_type)||!Object.keys(d).length)\n      return fail(index,'MISSING_CASE_DATA','五题结果缺少病例标识、癌种或病例页。');\n    const ids=new Set();\n    for(const item of q.questions){\n      if(!object(item)||!nonempty(item.id)||ids.has(item.id)||!nonempty(item.question)\n        ||!object(item.options)||Object.keys(item.options).length!==4\n        ||!['A','B','C','D'].every(k=>nonempty(item.options[k]))\n        ||!['A','B','C','D'].includes(item.answer)||item.answer_text!==item.options[item.answer]\n        ||!nonempty(item.explain))\n        return fail(index,'INVALID_QUESTION','题目字段、四个选项、答案对应关系或题目ID不符合输出契约。');\n      if(new Set(Object.values(item.options).map(s=>s.replace(/\\s+/g,'').trim())).size!==4||teachingErrors(item).length)\n        return fail(index,'INVALID_QUESTION','选项重复或A/B/C/D四行解析与答案不一致。');\n      if(item.id!=='Q'+(ids.size+1))return fail(index,'INVALID_QUESTION','题号必须连续Q1至Q5。');\n      ids.add(item.id);\n    }\n    items.push({file_index:index+1,status:'complete',case_id:q.case_id,question_count:5,execution_report});\n    return result;\n  });\n  const complete=items.filter(r=>r.status==='complete').length;\n  const incomplete=items.filter(r=>r.status==='incomplete').length;\n  const batch_report={schema_version:'batch-five-1.1',workflow_revision:'20260929-reference-recovery-batch',medical_review_status:'not_performed',scope:'structure_and_completion_only',expected_count,\n    complete_count:complete,incomplete_count:incomplete,failed_count:items.length-complete-incomplete,\n    status:complete===expected_count?'complete':complete?'partial':'no_complete_cases',\n    retry_file_indices:items.filter(r=>r.status!=='complete').map(r=>r.file_index),items};\n  return {response_json:JSON.stringify({output_data,batch_report}),output_data,output_json:JSON.stringify(output_data,null,2),batch_report,batch_report_json:JSON.stringify(batch_report)};\n}\n",
