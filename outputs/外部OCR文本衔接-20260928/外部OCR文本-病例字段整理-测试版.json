      },
      "inputs": [
        {
          "key": "system_addInputParam",
          "label": "",
          "valueType": "dynamic",
          "required": false,
          "customInputConfig": {
            "selectValueTypeList": [
              "string",
              "number",
              "boolean",
              "object",
