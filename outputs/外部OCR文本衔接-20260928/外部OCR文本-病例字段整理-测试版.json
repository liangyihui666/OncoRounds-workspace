            ],
            "showDescription": false,
            "showDefaultValue": true
          },
          "selectedType": "addInputParam",
          "renderTypeList": [
            "addInputParam"
          ],
          "debugLabel": "",
          "description": "workflow:these_variables_will_be_input_parameters_for_code_execution",
          "toolDescription": "",
          "canAgentGenerated": false
        },
        {
          "key": "codeType",
          "label": "",
          "valueType": "string",
          "selectedType": "hidden",
          "renderTypeList": [
            "hidden"
          ],
          "value": "js",
          "debugLabel": "",
