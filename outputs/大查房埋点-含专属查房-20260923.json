{
  "events": [
    {
      "id": "E01",
      "event_name": "GrandRoundsHomeView",
      "trigger": "大查房首页加载完成",
      "properties": [
        "platform",
        "device"
      ],
      "purpose": "首页曝光、入口到达"
    },
    {
      "id": "E02",
      "event_name": "GrandRoundsCaseView",
      "trigger": "病例卡片/病例详情有效曝光",
      "properties": [
        "grand_rounds_case_id",
        "grand_rounds_case_name",
        "grand_rounds_case_type"
      ],
      "purpose": "分析病例曝光及病例偏好"
    },
    {
      "id": "E03",
      "event_name": "GrandRoundsStartRoundClick",
      "trigger": "点击【开始查房】",
      "properties": [
        "grand_rounds_case_id",
        "grand_rounds_case_name"
      ],
      "purpose": "开始查房意愿、登录前置漏斗"
    },
    {
      "id": "E04",
      "event_name": "GrandRoundsRegisterLoginSuccess",
      "trigger": "因大查房触发登录，并登录成功回跳",
      "properties": [
        "grand_rounds_case_id"
      ],
      "purpose": "登录转化及登录造成的流失"
    },
    {
      "id": "E05",
      "event_name": "GrandRoundsContinueRoundClick",
      "trigger": "完成病例后点击【下一病例】",
      "properties": [
        "grand_rounds_case_id",
        "grand_rounds_round_id",
        "grand_rounds_next_case_id"
      ],
      "purpose": "判断完成首例后的继续意愿"
    },
    {
      "id": "E06",
      "event_name": "GrandRoundsRoundStart",
      "trigger": "正式进入病例问答首题",
      "properties": [
        "grand_rounds_round_id",
        "grand_rounds_case_id",
        "grand_rounds_case_name",
        "grand_rounds_entry_source"
      ],
      "purpose": "查房真正开始、连续查房分析"
    },
    {
      "id": "E07",
      "event_name": "GrandRoundsQuestionAnswer",
      "trigger": "用户提交单题答案",
      "properties": [
        "grand_rounds_round_id",
        "grand_rounds_case_id",
        "grand_rounds_question_id",
        "grand_rounds_is_correct",
        "grand_rounds_cost_time"
      ],
      "purpose": "单题正确率、耗时、病例难度分析"
    },
    {
      "id": "E08",
      "event_name": "GrandRoundsCaseComplete",
      "trigger": "完成最后一道题并成功生成/到达病例总结",
      "properties": [
        "grand_rounds_round_id",
        "grand_rounds_case_id",
        "grand_rounds_completed_at",
        "grand_rounds_duration"
      ],
      "purpose": "病例完成率、完成耗时、连续查房起点"
    },
    {
      "id": "E09",
      "event_name": "GrandRoundsSummaryView",
      "trigger": "总结页成功曝光",
      "properties": [
        "grand_rounds_round_id",
        "grand_rounds_case_id",
        "grand_rounds_score"
      ],
      "purpose": "总结页到达及后续行为分析"
    },
    {
      "id": "E10",
      "event_name": "GrandRoundsShareClick",
      "trigger": "点击【分享】",
      "properties": [
        "grand_rounds_round_id",
        "grand_rounds_case_id",
        "grand_rounds_share_channel"
      ],
      "purpose": "分享传播"
    },
    {
      "id": "E11",
      "event_name": "GrandRoundsUploadCaseClick",
      "trigger": "在专属查房页点击【上传你的病例】入口时触发；弹窗内点击【点击上传病例】不重复触发本事件",
      "properties": [],
      "purpose": "统计上传病例入口点击及使用意愿"
    },
    {
      "id": "E12",
      "event_name": "GrandRoundsGeneratePrivateRoundClick",
      "trigger": "已选择病例文件，用户点击可用状态的【生成专属查房】按钮时触发；禁用态点击不触发，不等待生成结果",
      "properties": [
        "grand_rounds_file_count"
      ],
      "purpose": "统计专属查房生成发起意愿；不代表生成成功"
    },
    {
      "id": "E13",
      "event_name": "GrandRoundsViewSummaryClick",
      "trigger": "在专属查房病例卡片点击【查看总结】时触发；总结页成功曝光仍上报E09",
      "properties": [
        "grand_rounds_round_id",
        "grand_rounds_case_id"
      ],
      "purpose": "统计已完成病例的总结回看意愿，并结合E09分析实际到达"
    }
  ],
  "property_notes": {
    "grand_rounds_file_count": {
      "type": "Number",
      "description": "本次选择用于生成的一份病例所包含的文件数量；多张照片按实际文件数计，不是病例数。"
    },
    "grand_rounds_round_id": {
      "description": "E13传入本次查看总结所对应的已有作答轮次ID，不新建轮次。"
    }
  }
}
